# =========================================================
# .gitignore tổng hợp - nhóm BTL Phát triển phần mềm mã nguồn mở
# Bao phủ nhiều ngôn ngữ vì chưa chốt công nghệ.
# LƯU Ý: KHÔNG ignore nhầm file nguồn (.py, .js, .ts, .java, .cs...).
# =========================================================

# -----------------------------
# Hệ điều hành
# -----------------------------
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------
# Trình soạn thảo / IDE
# -----------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# -----------------------------
# Node.js
# -----------------------------
node_modules/
dist/
build/
.env
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.cache/

# -----------------------------
# Python
# -----------------------------
__pycache__/
*.py[cod]
*.pyc
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# -----------------------------
# Java
# -----------------------------
*.class
target/
*.jar
*.war
.gradle/

# -----------------------------
# .NET / C#
# -----------------------------
bin/
obj/
*.user
*.suo

# -----------------------------
# Log & file tạm
# -----------------------------
*.log
*.tmp
.tmp/
