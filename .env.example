# OrderFlow – Mẫu cấu hình kết nối MySQL
# Sao chép file này thành `.env` ở thư mục gốc rồi điền thông tin thật của máy bạn:
#   Windows (cmd):        copy .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux/macOS:          cp .env.example .env
# KHÔNG commit file `.env` vì đã chứa mật khẩu thật (đã nằm trong .gitignore).
# Giá trị có chứa dấu # phải bọc trong dấu nháy kép (phần sau # bị coi là chú thích).

# Host MySQL (XAMPP mặc định: 127.0.0.1)
OF_DB_HOST=127.0.0.1

# Cổng MySQL (XAMPP mặc định: 3306)
# Nếu MySQL 8 / MariaDB chạy cổng khác, sửa số tương ứng, ví dụ 3307.
OF_DB_PORT=3306

# Tên database (file database.sql tạo sẵn database này)
OF_DB_NAME=orderflow

# Tài khoản MySQL (XAMPP mặc định: root)
OF_DB_USER=root

# Mật khẩu MySQL.
# Mặc định XAMPP: root KHÔNG có mật khẩu → để trống như dòng dưới.
# Nếu root CÓ mật khẩu, thay bằng mật khẩu thật của bạn, ví dụ:
# OF_DB_PASS=MAT-KHAU-CUA-BAN
# Nếu mật khẩu chứa dấu # hãy bọc mật khẩu trong dấu nháy kép.
OF_DB_PASS=
