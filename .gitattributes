# Chuẩn hoá line-ending: lưu LF trong repo, checkout theo hệ điều hành
* text=auto eol=lf

# Script Windows vẫn cần CRLF để chạy đúng
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Tệp nhị phân (không áp dụng chuyển đổi text)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bmp binary
*.svg text
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
